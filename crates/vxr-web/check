#!/usr/bin/env bash
# Check the browser build end to end in headless Chrome (chrome-devtools-axi on the PATH):
# serve crates/vxr-web/dist/ on 127.0.0.1 with the deploy's headers (check-server.js, with a
# stand-in model provider), run check.js in the page (every tool, camera, undo/redo, Cmd-K,
# the assistant, Open, Save, resize, the projects list and drafts), check the landing page and
# the boot skeleton (check-landing.js: first visit with progress and an early click, /about, the
# returning-visit skip, ?open= ?project= ?embed), check that a draft and a
# key remembered in the browser come back in a new page (check-restore.js for the draft), check that a tablet-sized touch screen starts in the touch layout, pair the
# page with a real `vxr bridge` (a debug build, which takes pages from 127.0.0.1, on a free port
# VXR_CHECK_BRIDGE_PORT or a picked one, not the fixed 41723 another bridge may hold) and edit it from a real `vxr mcp --live` driven by a scripted MCP client
# (check-agent.js), sign in from the account popover against the Worker under a local
# `wrangler dev` (check-account.js; needs `npm ci --prefix crates/vxr-web`), check the no-WebGPU
# message in a browser without WebGPU, and write 1x and 2x screenshots into the git-ignored
# crates/vxr-web/shots/.
# Prints ok or FAIL per step and exits 1 on any failure. Run crates/vxr-web/build first.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../.." && pwd)"
dist="$here/dist"
shots="$here/shots"
port="${VXR_CHECK_PORT:-4801}"
# The port the check's vxr bridge listens on and its page connects to, instead of the fixed 41723.
bridge_port="${VXR_CHECK_BRIDGE_PORT:-$(node -e "const s=require('net').createServer().listen(0,'127.0.0.1',()=>{console.log(s.address().port);s.close()})")}"
url="http://127.0.0.1:$port/"
[ -f "$dist/pkg/vxr_web_bg.wasm" ] || { echo "no $dist: run crates/vxr-web/build first" >&2; exit 1; }
npm --prefix "$here" run -s lint >&2 && npm --prefix "$here" run -s format:check >&2 || { echo "FAIL oxlint or oxfmt on site/" >&2; exit 1; }
command -v chrome-devtools-axi >/dev/null || { echo "chrome-devtools-axi is not on the PATH" >&2; exit 1; }
mkdir -p "$shots"

cd "$root"
# Generated fixtures the check opens through the file input, served under /__fixtures/
# from a temporary folder so dist/ stays the site.
fixtures="$(mktemp -d)"
trap 'rm -rf "$fixtures"' EXIT
./dev cargo run -q --release -p vxr-vox --example fixture -- 22-world "$fixtures/22-world.vox"
./dev cargo run -q --release -p vxr-vox --example fixture -- 23-desk "$fixtures/23-desk.vox"
./dev cargo build -q -p vxr-app
vxr="$root/target/debug/vxr"
./dev node "$here/check-server.js" "$dist" "$port" "$fixtures" "$bridge_port" &
server=$!
bridge=""
worker=""
gpu=vxr-check-$$
nogpu=vxr-check-nogpu-$$
cleanup() {
  CHROME_DEVTOOLS_AXI_SESSION=$gpu chrome-devtools-axi stop >/dev/null 2>&1 || true
  CHROME_DEVTOOLS_AXI_SESSION=$nogpu chrome-devtools-axi stop >/dev/null 2>&1 || true
  kill "$server" 2>/dev/null || true
  [ -z "$bridge" ] || kill "$bridge" 2>/dev/null || true
  [ -z "$worker" ] || kill "$worker" 2>/dev/null || true
  rm -rf "$fixtures"
}
trap cleanup EXIT
for _ in $(seq 50); do curl -sf "$url" >/dev/null && break; sleep 0.1; done

# eval prints the returned string JSON-quoted twice; unwrap it to plain lines.
unwrap() { sed -n 's/^result: //p' | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{let v=JSON.parse(s);while(typeof v==='string'&&v.startsWith('\"'))v=JSON.parse(v);console.log(v)})"; }

export CHROME_DEVTOOLS_AXI_SESSION=$gpu
export CHROME_DEVTOOLS_AXI_CHROME_ARGS='--enable-unsafe-webgpu --ignore-gpu-blocklist'
axi() { chrome-devtools-axi "$@"; }
# Empty the page's projects store (and take its scene as saved, so nothing is kept as the
# page goes): each page here starts with nothing to restore unless a step left it on purpose.
forget() { axi eval "async () => { window.vxr?.forget_projects(); await window.vxrProjects?.clear(); return 'ok' }" >/dev/null || true; }
# The landing page and the boot skeleton (check-landing.js): this profile's first visit, then
# its returning and deep-link visits, before anything else opens the page. The first visit holds
# the wasm back for 6 s, so the progress and an early click can be seen.
landing() { axi eval --full "async () => ($(cat "$here/check-landing.js"))('$1')" | unwrap; }
curl -sf "http://127.0.0.1:$port/__hold/6000" >/dev/null
axi open "$url" >/dev/null
axi emulate --viewport "1280x800x1" >/dev/null
land_results="$(landing first)"
axi screenshot "$shots/web-landing-loading.png" >/dev/null
land_results+=$'\n'"$(landing early)"
axi open "${url}about" >/dev/null
land_results+=$'\n'"$(landing ready)"
axi screenshot "$shots/web-landing.png" >/dev/null
land_results+=$'\n'"$(landing ready-click)"
axi open "$url" >/dev/null
land_results+=$'\n'"$(landing again)"
axi screenshot "$shots/web-boot-skeleton.png" >/dev/null
landing again-done >/dev/null
for q in "?open=scene.vox" "?project=abc" "?embed"; do
  land_results+=$'\n'"$(landing clear)"
  axi open "$url$q" >/dev/null
  land_results+=$'\n'"$(landing deep)"
done
axi open "$url" >/dev/null
axi eval "async () => { for (let i = 0; i < 300 && !window.vxr; i++) await new Promise(r => setTimeout(r, 50)); return 'ready' }" >/dev/null
forget
for scale in 1 2; do
  axi emulate --viewport "1280x800x$scale" >/dev/null
  axi open "$url" >/dev/null
  axi eval "async () => { for (let i = 0; i < 300 && !window.vxr; i++) await new Promise(r => setTimeout(r, 50)); await new Promise(r => setTimeout(r, 500)); return 'ready' }" >/dev/null
  axi screenshot "$shots/web-${scale}x.png" >/dev/null
  echo "wrote $shots/web-${scale}x.png"
done
# The touch layout on an iPad-sized touch screen, landscape and portrait, Neutral and Paper:
# a touch-first page starts in it.
touch_results=""
for view in 1180x820 820x1180; do
  for theme in neutral paper; do
    axi emulate --viewport "${view}x2,mobile,touch" >/dev/null
    axi open "$url" >/dev/null
    got="$(axi eval "async () => { for (let i = 0; i < 300 && !window.vxr; i++) await new Promise(r => setTimeout(r, 50)); window.vxr.set_theme('$theme'); await new Promise(r => setTimeout(r, 800)); const s = JSON.parse(window.vxr.state()); return JSON.stringify([s.touch, window.vxr.hit('dock').length > 0, window.vxr.hit('render').length > 0]) }" | unwrap)"
    axi screenshot "$shots/web-touch-$view-$theme.png" >/dev/null
    echo "wrote $shots/web-touch-$view-$theme.png"
    corner=$([ "$view" = 1180x820 ] && echo true || echo false)
    if [[ "$got" == "[true,true,$corner]" ]]; then
      touch_results+=$'\nok '"$view $theme: a touch screen starts in the touch layout with the dock"
    else
      touch_results+=$'\nFAIL '"$view $theme: a touch screen starts in the touch layout with the dock: $got"
    fi
  done
done
# The touch layout on phones, upright and sideways: the dock, the top bar and every panel stay
# on screen and the dock stays reachable (check-phone.js, one stage per call so each can be
# screenshotted).
for view in 390x844 844x390; do
  axi emulate --viewport "${view}x3,mobile,touch" >/dev/null
  axi open "$url" >/dev/null
  for stage in plain assistant palette select export colour commands; do
    got="$(axi eval --full "async () => ($(cat "$here/check-phone.js"))('$stage', '$view')" | unwrap)"
    axi screenshot "$shots/web-phone-$view-$stage.png" >/dev/null
    echo "wrote $shots/web-phone-$view-$stage.png"
    touch_results+=$'\n'"$got"
  done
done
axi emulate --viewport "1280x800x1" >/dev/null
forget
axi open "$url" >/dev/null
# check.js outlasts one eval's 60 s request limit: start it, then poll for its lines.
axi eval "() => { window.__check = null; ($(sed -n '/^async/,$p' "$here/check.js"))().then((r) => { window.__check = r }, (e) => { window.__check = 'FAIL check.js threw: ' + e }); return 'started' }" >/dev/null
results=""
for _ in $(seq 600); do
  results="$(axi eval --full "() => window.__check || ''" | unwrap)"
  [ -n "$results" ] && break
  sleep 1
done
[ -n "$results" ] || results="FAIL check.js did not finish in 10 minutes"
results+="$touch_results"
results+=$'\n'"$land_results"
axi screenshot "$shots/web-1x-checked.png" >/dev/null

# A draft outlives its page: an edit, a new page that offers it back, and Restore.
forget
axi open "$url" >/dev/null
restore() { axi eval --full "async () => ($(cat "$here/check-restore.js"))('$1')" | unwrap; }
results+=$'\n'"$(restore edit)"
axi open "$url" >/dev/null
results+=$'\n'"$(restore offer)"
axi screenshot "$shots/web-restore.png" >/dev/null
results+=$'\n'"$(restore restore)"
forget

# A key check.js asked this browser to remember comes back, encrypted, in a new page.
axi open "$url" >/dev/null
back="$(axi eval "async () => { for (let i = 0; i < 300 && !window.vxr; i++) await new Promise(r => setTimeout(r, 50)); await new Promise(r => setTimeout(r, 500)); const a = JSON.parse(window.vxr.ai()); await window.vxrKeys.forget('compatible'); return JSON.stringify([a.hasKey[2], a.remembered[2], a.kind]) }" | unwrap)"
if [[ "$back" == '[true,true,"compatible"]' ]]; then
  results+=$'\nok a key remembered in this browser is back in a new page (and forgotten again)'
else
  results+=$'\nFAIL a key remembered in this browser is back in a new page: '"$back"
fi

# Live mode through a real vxr bridge: its live folder (socket and token) in the temporary
# folder, the page pairing with the code it printed, and a real `vxr mcp --live` editing.
export VXR_LIVE_DIR="$fixtures/live"
VXR_BRIDGE_PORT="$bridge_port" "$vxr" bridge >"$fixtures/bridge.log" 2>&1 &
bridge=$!
code=""
for _ in $(seq 100); do
  code="$(sed -n 's/^  Pairing code: //p' "$fixtures/bridge.log" | tail -1)"
  [ -n "$code" ] && break
  sleep 0.1
done
pass() { results+=$'\n'"ok $1"; }
fail() { results+=$'\n'"FAIL $1: $2"; }
expect() { if [ "$2" = "$3" ]; then pass "$1"; else fail "$1" "$2"; fi; }
if [ -z "$code" ]; then
  fail "vxr bridge prints a pairing code" "$(cat "$fixtures/bridge.log")"
else
  pass "vxr bridge prints a pairing code"
  axi open "$url" >/dev/null
  # Cmd-K Terminal agents, the code, Enter: the page pairs.
  paired="$(axi eval "async () => {
    for (let i = 0; i < 300 && !window.vxr; i++) await new Promise(r => setTimeout(r, 50));
    const c = document.getElementById('c');
    const frames = (n = 3) => new Promise((r) => { const f = () => (--n > 0 ? requestAnimationFrame(f) : r()); requestAnimationFrame(f); });
    const key = async (k, mods = {}) => { const o = { key: k, bubbles: true, cancelable: true, ...mods }; c.dispatchEvent(new KeyboardEvent('keydown', o)); c.dispatchEvent(new KeyboardEvent('keyup', o)); await frames(); };
    const click = async ([x, y]) => { for (const type of ['pointermove', 'pointerdown', 'pointerup']) { c.dispatchEvent(new PointerEvent(type, { clientX: x, clientY: y, button: type === 'pointermove' ? -1 : 0, buttons: type === 'pointerdown' ? 1 : 0, pointerId: 1, pointerType: 'mouse', isPrimary: true, bubbles: true, cancelable: true })); await frames(); } };
    // Scroll the Agents tab until the named control is inside the window: the ACTIVITY list
    // can push the bottom of the tab below a laptop-sized window.
    const reveal = async (name) => { for (let i = 0; i < 40; i++) { const [x, y] = window.vxr.hit(name); if (y < innerHeight - 24) break; c.dispatchEvent(new WheelEvent('wheel', { clientX: x, clientY: innerHeight / 2, deltaY: 200, bubbles: true, cancelable: true })); await frames(); } return window.vxr.hit(name); };
    window.__key = key; window.__click = click; window.__frames = frames; window.__reveal = reveal;
    await frames(10);
    await key('k', { metaKey: true });
    for (const ch of 'terminal agents') await key(ch);
    await key('Enter');
    await click(window.vxr.hit('agents-code'));
    for (const ch of '00000000') await key(ch);
    for (let i = 0; i < 200 && JSON.parse(window.vxr.state()).agents.fail !== 'Wrong'; i++) await frames(3);
    const wrong = JSON.parse(window.vxr.state()).agents.fail;
    await click(window.vxr.hit('agents-retry'));
    await frames(3);
    await click(window.vxr.hit('agents-code'));
    for (const ch of '$code') await key(ch);
    for (let i = 0; i < 200 && !JSON.parse(window.vxr.state()).agents.allowed; i++) await frames(3);
    const a = JSON.parse(window.vxr.state()).agents;
    return JSON.stringify([wrong, a.allowed, a.error]);
  }" | unwrap)"
  expect "a wrong code turns the step red, and the page pairs with the code vxr bridge printed" "$paired" '["Wrong",true,null]'
  [ -S "$VXR_LIVE_DIR/live.sock" ] && pass "vxr bridge opens the agents' socket once paired" || fail "vxr bridge opens the agents' socket once paired" "no socket"
  # An agent session that makes no call connects by itself: step 3 turns green with an idle row.
  ./dev node "$here/check-agent.js" "$vxr" "[\"wait $fixtures/idle-done\"]" >/dev/null &
  idler=$!
  idle="$(axi eval "async () => { for (let i = 0; i < 400 && !JSON.parse(window.vxr.state()).agents.clients.length; i++) await window.__frames(3); await window.__frames(4); const a = JSON.parse(window.vxr.state()).agents; return JSON.stringify([a.clients.map(c => c[1]), a.calls.length, a.chip.replace(/ · idle .*/, ' · idle'), window.vxr.hit('agents-dot-' + (a.clients[0] || [0])[0]).length]) }" | unwrap)"
  expect "an open agent session shows as connected and idle before any call" "$idle" '[["Claude Code"],0,"Claude Code connected · idle",2]'
  axi screenshot "$shots/web-agent-idle.png" >/dev/null
  touch "$fixtures/idle-done"
  wait "$idler" || true
  left="$(axi eval "async () => { for (let i = 0; i < 200 && JSON.parse(window.vxr.state()).agents.clients.length; i++) await window.__frames(3); return JSON.stringify(JSON.parse(window.vxr.state()).agents.clients) }" | unwrap)"
  expect "the session leaves the list when it ends" "$left" '[]'
  before="$(axi eval "() => JSON.stringify(JSON.parse(window.vxr.state()).voxels)" | unwrap)"
  # One agent: a box and two colours in one palette_set, then (after the page's Stop) another
  # call that must be refused.
  ./dev node "$here/check-agent.js" "$vxr" "[[\"box\", {\"from\": [-64, 28, -63], \"to\": [-63, 29, -62], \"slot\": 7}], [\"palette_set\", {\"slots\": [{\"slot\": 250, \"hex\": \"#2a8f4a\"}, {\"slot\": 251, \"hex\": \"#1f6b38\"}]}], \"wait $fixtures/stopped\", [\"scene_summary\", {}]]" >"$fixtures/agent.log" &
  agent=$!
  for _ in $(seq 100); do [ "$(wc -l <"$fixtures/agent.log")" -ge 2 ] && break; sleep 0.1; done
  applied() { node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{const r=JSON.parse(s);console.log(r.isError?r.text:'applied')})"; }
  expect "a real vxr mcp --live edits the page through the bridge" "$(sed -n 1p "$fixtures/agent.log" | applied)" "applied"
  expect "a palette_set of two slots through the bridge" "$(sed -n 2p "$fixtures/agent.log" | applied)" "applied"
  shown="$(axi eval "async () => { await window.__frames(10); const s = JSON.parse(window.vxr.state()); return JSON.stringify([s.voxels - $before, s.undoLabel, s.agents.clients.map(c => c[1]), s.agents.edits.map(e => e.label), Array.from(window.vxr.color(250)).slice(0, 3), Array.from(window.vxr.color(251)).slice(0, 3)]) }" | unwrap)"
  expect "each edit is one undo step named after the agent, listed with it" "$shown" '[8,"Claude Code: palette_set 2 slots",["Claude Code"],["Claude Code: box 8 voxels","Claude Code: palette_set 2 slots"],[42,143,74],[31,107,56]]'
  axi screenshot "$shots/web-agents.png" >/dev/null
  # ACTIVITY lists every call the agent made, queries included, with its edit and an answer in a line.
  calls="$(axi eval "() => JSON.stringify(JSON.parse(window.vxr.state()).agents.calls.map((c) => [c.tool, c.edit, c.running, c.ok, c.result.length > 0]))" | unwrap)"
  expect "the Agents tab keeps each call, linked to its edit, with its answer" "$calls" '[["box",0,false,true,true],["palette_set",1,false,true,true]]'
  rows="$(axi eval "async () => { await window.__click(window.vxr.hit('ai-tab-agents')); await window.__frames(4); return JSON.stringify([window.vxr.hit('agent-call-0').length, window.vxr.hit('agent-undo-0').length, window.vxr.hit('agent-undo-1').length]) }" | unwrap)"
  expect "ACTIVITY draws a row per call with an Undo on each edit" "$rows" '[2,2,2]'
  axi screenshot "$shots/web-agent-activity.png" >/dev/null
  # The hint-bar chip follows the Agents tab: a call 1 s ago, 95 s ago (amber, counting), 200 s ago.
  chip="$(axi eval "async () => { const chip = async (ago) => { window.vxr.agents_called_ago(ago); await window.__frames(2); return JSON.parse(window.vxr.state()).agents }; const words = (a) => a.chip.replace(/ \\d+ s\\b/g, ' N s'); const one = await chip(1), stall = await chip(95), long = await chip(200); return JSON.stringify([words(one), one.live, words(stall), stall.live, words(long), long.live]) }" | unwrap)"
  expect "the chip names the last call, then counts the quiet: amber at 45 s, may be stuck at 2 min" "$chip" '["Claude Code · Set colours · just now",["active"],"No call from Claude Code for 1 min N s · last set colours",["stall"],"Claude Code may be stuck: no call for 3 min N s",["long"]]'
  axi screenshot "$shots/web-agent-stuck.png" >/dev/null
  # Stop in the panel: the agent's next call is told it was stopped.
  stopped="$(axi eval "async () => { const s = JSON.parse(window.vxr.state()); await window.__click(window.vxr.hit('agents-stop-' + s.agents.clients[0][0])); for (let i = 0; i < 100 && JSON.parse(window.vxr.state()).agents.clients.length; i++) await window.__frames(3); return JSON.stringify(JSON.parse(window.vxr.state()).agents.clients) }" | unwrap)"
  touch "$fixtures/stopped"
  wait "$agent" || true
  expect "Stop in the panel disconnects the agent" "$stopped" '[]'
  case "$(tail -1 "$fixtures/agent.log")" in
    *"pressed Stop in vxr"*) pass "the stopped agent is told so" ;;
    *) fail "the stopped agent is told so" "$(tail -1 "$fixtures/agent.log")" ;;
  esac
  # Review every agent change: the panel's second switch. A real agent's edits wait as a
  # preview; Apply lands them as its undo steps, Discard leaves nothing, and the agent hears
  # which (review_status, or its next call); Stop during a review leaves the change waiting.
  rlog="$fixtures/review.log"
  rlines() { for _ in $(seq 150); do [ "$(wc -l <"$rlog" 2>/dev/null || echo 0)" -ge "$1" ] && break; sleep 0.1; done; }
  rtext() { sed -n "${1}p" "$rlog" | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{const r=JSON.parse(s||'{}');console.log((r.isError?'error: ':'')+(r.text||'').split('\n')[0])})"; }
  review="$(axi eval "async () => { const off = JSON.parse(window.vxr.state()).agents.review; await window.__click(window.vxr.hit('agents-review')); await window.__frames(5); const on = JSON.parse(window.vxr.state()).agents.review; await window.__click(window.vxr.hit('ai-tab-chat')); await window.__frames(5); return JSON.stringify([off, on]) }" | unwrap)"
  expect "the panel's review switch is off by default and turns on" "$review" '[false,true]'
  before="$(axi eval "() => JSON.stringify(JSON.parse(window.vxr.state()).voxels)" | unwrap)"
  box() { echo "[\"box\", {\"from\": [$1, 28, -63], \"to\": [$(($1 + 1)), 28, -62], \"slot\": 7}]"; }
  ./dev node "$here/check-agent.js" "$vxr" "[$(box -60), [\"review_status\", {}], \"wait $fixtures/go1\", [\"review_status\", {}], $(box -56), \"wait $fixtures/go2\", [\"scene_summary\", {}], $(box -52), \"wait $fixtures/stopped2\", [\"scene_summary\", {}]]" >"$rlog" &
  agent=$!
  rlines 2
  case "$(rtext 1)|$(rtext 2)" in
    "4 cells changed"*"waiting for the user's review"*"|1 edit of yours waits"*) pass "with review on the agent's edit waits, and review_status says so" ;;
    *) fail "with review on the agent's edit waits, and review_status says so" "$(cat "$rlog")" ;;
  esac
  shown="$(axi eval "async () => { await window.__frames(10); const s = JSON.parse(window.vxr.state()); return JSON.stringify([s.voxels - $before, s.undoLabel, s.review && s.review.agents, s.review && s.review.prompt, s.review && s.review.counts]) }" | unwrap)"
  expect "the page shows it as an agent change with no undo step yet" "$shown" '[4,"Claude Code: palette_set 2 slots",true,"Claude Code",[4,0,0]]'
  axi screenshot "$shots/web-agent-review.png" >/dev/null
  applied="$(axi eval "async () => { await window.__click(window.vxr.hit('review-apply')); await window.__frames(5); const s = JSON.parse(window.vxr.state()); return JSON.stringify([s.voxels - $before, s.undoLabel, s.review, s.agents.edits.map(e => e.label).slice(-1)]) }" | unwrap)"
  expect "Apply lands the edit as an undo step named after the agent" "$applied" '[4,"Claude Code: box 4 voxels",null,["Claude Code: box 4 voxels"]]'
  touch "$fixtures/go1"
  rlines 4
  case "$(rtext 3)" in
    "vxr: the user applied your 1 edit"*) pass "review_status tells the agent it was applied" ;;
    *) fail "review_status tells the agent it was applied" "$(rtext 3)" ;;
  esac
  discarded="$(axi eval "async () => { await window.__frames(5); const staged = JSON.parse(window.vxr.state()).review?.counts; await window.__click(window.vxr.hit('review-discard')); await window.__frames(5); const s = JSON.parse(window.vxr.state()); return JSON.stringify([staged, s.voxels - $before, s.undoLabel, s.review]) }" | unwrap)"
  expect "Discard leaves the scene and its undo steps as they were" "$discarded" '[[4,0,0],4,"Claude Code: box 4 voxels",null]'
  touch "$fixtures/go2"
  rlines 6
  case "$(rtext 5)" in
    "vxr: the user discarded"*) pass "the agent's next call says it was discarded" ;;
    *) fail "the agent's next call says it was discarded" "$(rtext 5)" ;;
  esac
  stopped="$(axi eval "async () => { await window.__frames(5); await window.__click(window.vxr.hit('agent-stop')); for (let i = 0; i < 100 && JSON.parse(window.vxr.state()).agents.clients.length; i++) await window.__frames(3); const s = JSON.parse(window.vxr.state()); return JSON.stringify([s.agents.clients, s.review && s.review.counts]) }" | unwrap)"
  touch "$fixtures/stopped2"
  wait "$agent" || true
  expect "Stop during a review cuts the agent off and leaves its edit waiting" "$stopped" '[[],[4,0,0]]'
  case "$(rtext 7)" in
    "error: The user pressed Stop in vxr"*) pass "the agent stopped during a review is told so" ;;
    *) fail "the agent stopped during a review is told so" "$(rtext 7)" ;;
  esac
  reopened="$(axi eval "async () => {
    await window.__click(window.vxr.hit('review-discard'));
    await window.__key('k', { metaKey: true });
    for (const ch of 'terminal agents') await window.__key(ch);
    await window.__key('Enter');
    await window.__click(window.vxr.hit('agents-review'));
    await window.__frames(5);
    const s = JSON.parse(window.vxr.state());
    return JSON.stringify([s.review, s.voxels - $before, s.agents.panel, s.agents.review]);
  }" | unwrap)"
  expect "Discard, then review off again in the panel" "$reopened" '[null,4,true,false]'
  # A real agent's look, render settings and exports through the bridge: the picture comes
  # back as MCP image content, the settings reach the Render panel, and the PNG slices and a
  # render download in the page under the scene's name.
  axi eval "() => { window.__downloads = []; HTMLAnchorElement.prototype.click = function () { window.__downloads.push(this.download); }; return 'ok' }" >/dev/null
  ./dev node "$here/check-agent.js" "$vxr" '[["look", {"view": "front", "size": 128}], ["render_settings", {"gamma": 1.8, "samples": 64, "export_size": "720p"}], ["export", {"kind": "slices"}], ["export", {"kind": "render"}]]' >"$fixtures/look.log"
  looked="$(sed -n 1p "$fixtures/look.log" | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{const r=JSON.parse(s);console.log(JSON.stringify([r.isError, JSON.parse(r.text).view, r.image]))})")"
  expect "look answers a real agent with a PNG picture through the bridge" "$looked" '[false,"front",{"mimeType":"image/png","png":"PNG"}]'
  set_gamma="$(sed -n 2p "$fixtures/look.log" | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{const r=JSON.parse(s);const v=JSON.parse(r.text);console.log(JSON.stringify([r.isError, v.gamma, v.samples]))})")"
  expect "render_settings answers with every setting" "$set_gamma" '[false,1.8,64]'
  exported="$(sed -n '3,4p' "$fixtures/look.log" | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{console.log(JSON.stringify(s.trim().split('\n').map(l=>{const r=JSON.parse(l);return r.isError?r.text:JSON.parse(r.text).exported[0]})))})")"
  expect "export downloads the PNG slices and, once traced, the render" "$exported" '["island-slices.png","island-render.png"]'
  downloads="$(axi eval "async () => { await window.__frames(5); const s = JSON.parse(window.vxr.state()); return JSON.stringify([window.__downloads, s.render.gamma, s.render.maxSpp, s.voxels - $before]) }" | unwrap)"
  expect "the page downloads them, the Render panel has the settings, and no voxel changed" "$downloads" '[["island-slices.png","island-render.png"],1.8,64,4]'
  # Regenerate writes a new token; the switch unpairs the page and the socket goes.
  token="$(cat "$VXR_LIVE_DIR/live.token")"
  axi eval "async () => { await window.__click(await window.__reveal('agents-regenerate')); await window.__frames(20); return 'ok' }" >/dev/null
  [ "$token" != "$(cat "$VXR_LIVE_DIR/live.token")" ] && pass "Regenerate in the panel writes a new token" || fail "Regenerate in the panel writes a new token" "same token"
  off="$(axi eval "async () => { await window.__click(await window.__reveal('agents-disconnect')); for (let i = 0; i < 100 && JSON.parse(window.vxr.state()).agents.allowed; i++) await window.__frames(3); await new Promise(r => setTimeout(r, 300)); return JSON.stringify(JSON.parse(window.vxr.state()).agents.allowed) }" | unwrap)"
  [ "$off" = false ] && [ ! -e "$VXR_LIVE_DIR/live.sock" ] && pass "Disconnect unpairs the page and the socket closes" || fail "Disconnect unpairs the page and the socket closes" "$off"
  for line in "Paired with the page: terminal agents can edit its scene now" "Claude Code connected" "The page left: agents can no longer edit it"; do
    grep -qF "$line" "$fixtures/bridge.log" && pass "vxr bridge prints: $line" || fail "vxr bridge prints: $line" "$(cat "$fixtures/bridge.log")"
  done
  ! grep -qF "$code" <(sed '/Pairing code/d' "$fixtures/bridge.log") && pass "vxr bridge never prints the code again" || fail "vxr bridge never prints the code again" "$(cat "$fixtures/bridge.log")"
fi
kill "$bridge" 2>/dev/null || true
bridge=""

# Sign-in from the account popover against the Worker under `wrangler dev --local` (local D1
# and R2 in the temporary folder, the always-pass Turnstile test secret, emails printed to its
# log, never sent): a code, a wrong code, the menu, Sign out, then a link opened in another tab,
# then signed in again: Save to the library, Export library and Delete account
# (check-account.js, one stage per call so each can be screenshotted).
wrangler="$here/node_modules/.bin/wrangler"
if [ ! -x "$wrangler" ]; then
  fail "the account popover signs in against wrangler dev" "no $wrangler: run npm ci --prefix crates/vxr-web"
else
  aport="${VXR_CHECK_ACCOUNT_PORT:-4802}"
  aurl="http://127.0.0.1:$aport/"
  wlog="$fixtures/wrangler.log"
  # From crates/vxr-web, where wrangler keeps its git-ignored .wrangler/ cache.
  (cd "$here" && exec "$wrangler" d1 migrations apply vxr --local --persist-to "$fixtures/wrangler") >"$wlog" 2>&1
  (cd "$here" && exec "$wrangler" dev --local --ip 127.0.0.1 --port "$aport" --local-upstream "127.0.0.1:$aport" \
    --persist-to "$fixtures/wrangler" --show-interactive-dev-session=false \
    --var "BETTER_AUTH_SECRET:$(openssl rand -hex 32)" --var TURNSTILE_SECRET_KEY:1x0000000000000000000000000000000AA \
    --var EMAIL_SENDER:log) >>"$wlog" 2>&1 &
  worker=$!
  for _ in $(seq 300); do curl -sf "${aurl}api/me" >/dev/null && break; sleep 0.1; done
  account() { axi eval --full "async () => ($(cat "$here/check-account.js"))('$1', '${2:-}')" | unwrap; }
  # Wait for the nth email in the wrangler log.
  mail() { for _ in $(seq 200); do [ "$(grep -c '^\[vxr mail\]' "$wlog")" -ge "$1" ] && break; sleep 0.1; done; }
  # The id of the newest tab (newpage does not always select a page whose load failed).
  newest() { axi pages | awk -F, '/^ +[0-9]+,/ { gsub(/ /, "", $1); id = $1 } END { print id }'; }
  ashot() { axi screenshot "$shots/web-account-$1.png" >/dev/null; echo "wrote $shots/web-account-$1.png"; }
  axi open "$aurl" >/dev/null
  axi emulate --viewport "1280x800x2" >/dev/null
  axi open "${aurl}about" >/dev/null
  results+=$'\n'"$(account landing)"
  axi open "$aurl" >/dev/null
  results+=$'\n'"$(account open)"
  ashot email
  results+=$'\n'"$(account ask ada@example.com)"
  mail 1
  ashot code
  results+=$'\n'"$(account wrong)"
  ashot wrong-code
  results+=$'\n'"$(account code "$(sed -n 's/^\[vxr mail\] to ada@example.com: Sign in to vxr: \([0-9]\{6\}\)$/\1/p' "$wlog" | tail -1)")"
  ashot signed-in
  results+=$'\n'"$(account menu)"
  ashot menu
  results+=$'\n'"$(account out)"
  results+=$'\n'"$(account listen)"
  results+=$'\n'"$(account ask ada@example.com)"
  mail 2
  editor="$(axi pages | grep -F ",$aurl," | cut -d, -f1 | tr -d ' ')"
  # The link redirects to the account page, which newpage reports as a failed load; the link
  # stage checks what came of it.
  axi newpage "$(grep -oE "http://127\.0\.0\.1:$aport/api/auth/magic-link/verify\?[^ ]+" "$wlog" | tail -1)" >/dev/null || true
  # This tab is the account page the link landed on.
  landed="$(newest)"
  axi selectpage "$landed" >/dev/null
  results+=$'\n'"$(account landed)"
  ashot landed
  axi selectpage "$editor" >/dev/null
  results+=$'\n'"$(account link)"
  ashot link
  # Sign out on the account page (its tab stays signed in until the editor tab has seen it).
  axi selectpage "$landed" >/dev/null
  results+=$'\n'"$(account landed-out)"
  # The same link a second time (and a failed one) comes back to the page with ?link=expired.
  axi newpage "${aurl}account?link=expired" >/dev/null || true
  axi selectpage "$(newest)" >/dev/null
  results+=$'\n'"$(account expired)"
  ashot expired
  # Back in the editor tab: sign in again by code, then Export library and Delete account.
  axi selectpage "$editor" >/dev/null
  results+=$'\n'"$(account again)"
  results+=$'\n'"$(account ask ada@example.com)"
  mail 3
  results+=$'\n'"$(account code "$(sed -n 's/^\[vxr mail\] to ada@example.com: Sign in to vxr: \([0-9]\{6\}\)$/\1/p' "$wlog" | tail -1)")"
  results+=$'\n'"$(account save)"
  results+=$'\n'"$(account export)"
  results+=$'\n'"$(account delete)"
  ashot delete
  results+=$'\n'"$(account deleted)"
  ashot deleted
  kill "$worker" 2>/dev/null || true
  worker=""
fi
axi emulate --viewport "1280x800x1" >/dev/null

export CHROME_DEVTOOLS_AXI_SESSION=$nogpu
export CHROME_DEVTOOLS_AXI_CHROME_ARGS='--disable-gpu --disable-webgpu'
axi open "$url" >/dev/null
axi emulate --viewport "1280x800x1" >/dev/null
axi open "$url" >/dev/null
msg="$(axi eval "async () => { await new Promise(r => setTimeout(r, 1000)); return document.getElementById('msg').innerText }" | unwrap)"
if [[ "$msg" == "This browser has no WebGPU."* ]]; then
  results+=$'\nok without WebGPU the page says so'
else
  results+=$'\nFAIL without WebGPU the page says so: '"$msg"
fi
axi screenshot "$shots/web-no-webgpu.png" >/dev/null

echo "$results"
! grep -q '^FAIL' <<<"$results"
