// The browser editor on Cloudflare: static assets only, no Worker code.
// Build with ./build. Workers Builds deploys main with ./cloudflare-build (see the README);
// ./deploy deploys by hand.
{
  "name": "vxr",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "vxr.jrnxf.co", "custom_domain": true }]
}
