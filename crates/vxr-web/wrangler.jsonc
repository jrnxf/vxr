// The browser editor on Cloudflare: the static site in ./dist, and a small Worker (worker/) for
// the optional account and the cloud projects behind /api/* and /account. Every other path is a
// static file, served without running the Worker.
//
// Secrets (`wrangler secret put`, or .dev.vars for `wrangler dev`, see .dev.vars.example):
// BETTER_AUTH_SECRET signs sessions, TURNSTILE_SECRET_KEY checks the sign-up challenge and
// RESEND_API_KEY sends the emailed sign-in links. Without them the Worker still serves the site and
// answers /api/me with sign-in (or email sign-in) off.
{
  "name": "vxr",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/account"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vxr",
      "database_id": "e7319cb3-8df7-4725-a15b-db1e25e06ded",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PROJECTS", "bucket_name": "vxr-projects" }],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "vxr.jrnxf.co", "custom_domain": true }],
  // Branch builds (`--env preview`): a separate Worker, vxr-preview, on workers.dev only, with its
  // own database and bucket and its own secrets (none by default, so sign-in is off there). Fill in
  // database_id from `npx wrangler d1 create vxr-preview`; README.md "Deploy" has the steps.
  "env": {
    "preview": {
      "routes": [],
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vxr-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "PROJECTS", "bucket_name": "vxr-projects-preview" }]
    }
  }
}
