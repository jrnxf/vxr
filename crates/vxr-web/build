#!/usr/bin/env bash
# Build the browser editor as a static site in crates/vxr-web/dist/ (git-ignored):
# the wasm (profile wasm, wasm-opt -O3), the page, the UI fonts with their licences, and the
# prototype's island as scene.vox. Serve dist/ from any static host; deploy with ./deploy.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../.." && pwd)"
dist="$here/dist"
fonts="$root/crates/vxr-app/fonts"
[ -f "$fonts/lucide-LICENSE.txt" ] || "$root/crates/vxr-app/fetch-fonts"

cd "$root"
./dev cargo build --profile wasm --target wasm32-unknown-unknown -p vxr-web
rm -rf "$dist"
mkdir -p "$dist/pkg" "$dist/fonts"
./dev wasm-bindgen --target web --no-typescript --out-dir "$dist/pkg" target/wasm32-unknown-unknown/wasm/vxr_web.wasm
./dev wasm-opt -O3 --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext \
  --enable-mutable-globals --enable-reference-types -o "$dist/pkg/vxr_web_bg.wasm" "$dist/pkg/vxr_web_bg.wasm"
cp "$here/www/index.html" "$here/www/app.js" "$here/www/style.css" "$here/www/_headers" "$dist/"
cp "$fonts"/*.ttf "$fonts"/*.txt "$dist/fonts/"
node --input-type=module -e "
import fs from 'node:fs';
const core = fs.readFileSync('prototype/src/core.js', 'utf8');
const api = new Function(core + '\nreturn { VoxelWorld, generateIsland, writeVox, defaultPalette };')();
const w = new api.VoxelWorld();
api.generateIsland(w);
fs.writeFileSync(process.argv[1], api.writeVox(w, api.defaultPalette()));
" "$dist/scene.vox"
for f in "$dist/pkg/vxr_web_bg.wasm" "$dist/pkg/vxr_web.js" "$dist/scene.vox"; do
  printf '%-20s %9d B raw %9d B brotli\n' "$(basename "$f")" "$(wc -c <"$f")" "$(./dev brotli -c -q 11 "$f" | wc -c)"
done
