#!/usr/bin/env bash
# Build the browser editor as a static site in crates/vxr-web/dist/ (git-ignored):
# the wasm (profile wasm, wasm-opt -O3), the page and its icons, the UI fonts with their licences, the
# prototype's island as scene.vox, and the account page (account/, bundled with esbuild from the npm
# packages in package.json). Serve dist/ from any static host (the account page needs the Worker,
# see wrangler.jsonc); deploy with ./deploy. TURNSTILE_SITE_KEY sets the Turnstile site key of the
# account page and the editor's sign-in popover; unset, it is Cloudflare's always-pass test key.
# The tools come from the nix dev shell (../../dev); with VXR_TOOLS=path they come from the PATH
# instead, as ./cloudflare-build sets up where there is no nix.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../.." && pwd)"
dist="$here/dist"
fonts="$root/crates/vxr-app/fonts"
run() { if [ "${VXR_TOOLS:-}" = path ]; then "$@"; else "$root/dev" "$@"; fi; }
if ! (cd "$fonts" 2>/dev/null && shasum -a 256 -c "$root/crates/vxr-app/fonts.sha256" >/dev/null 2>&1); then
  "$root/crates/vxr-app/fetch-fonts"
fi

cd "$root"
run cargo build --profile wasm --target wasm32-unknown-unknown -p vxr-web
rm -rf "$dist"
mkdir -p "$dist/pkg" "$dist/fonts"
run wasm-bindgen --target web --no-typescript --out-dir "$dist/pkg" target/wasm32-unknown-unknown/wasm/vxr_web.wasm
run wasm-opt -O3 --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext \
  --enable-mutable-globals --enable-reference-types -o "$dist/pkg/vxr_web_bg.wasm" "$dist/pkg/vxr_web_bg.wasm"
cp "$here/www/index.html" "$here/www/app.js" "$here/www/style.css" "$here/www/_headers" \
  "$here/www/favicon.svg" "$here/www/apple-touch-icon.png" "$dist/"
cp "$fonts"/*.ttf "$fonts"/*.txt "$dist/fonts/"
site_key="${TURNSTILE_SITE_KEY:-1x00000000000000000000AA}"
[[ "$site_key" =~ ^[0-9A-Za-z_-]+$ ]] || { echo "build: TURNSTILE_SITE_KEY has unexpected characters" >&2; exit 1; }
node -e "
const fs = require('fs');
const [f, key] = process.argv.slice(1);
const line = /^const TURNSTILE_SITE_KEY = '[^']*';/m;
const js = fs.readFileSync(f, 'utf8');
if (!line.test(js)) throw new Error(f + ' has no TURNSTILE_SITE_KEY line');
fs.writeFileSync(f, js.replace(line, \"const TURNSTILE_SITE_KEY = '\" + key + \"';\"));
" "$dist/app.js" "$site_key"
[ -d "$here/node_modules" ] || npm ci --prefix "$here" --no-audit --no-fund
"$here/node_modules/.bin/esbuild" "$here/account/account.ts" --bundle --minify --format=esm --target=es2022 \
  --define:TURNSTILE_SITE_KEY="\"$site_key\"" --outfile="$dist/account.js" --log-level=warning
cp "$here/account/index.html" "$dist/account.html"
cp "$here/account/account.css" "$dist/account.css"
node --input-type=module -e "
import fs from 'node:fs';
const core = fs.readFileSync('prototype/src/core.js', 'utf8');
const api = new Function(core + '\nreturn { VoxelWorld, generateIsland, writeVox, defaultPalette };')();
const w = new api.VoxelWorld();
api.generateIsland(w);
fs.writeFileSync(process.argv[1], api.writeVox(w, api.defaultPalette()));
" "$dist/scene.vox"
node --input-type=module -e "
import fs from 'node:fs';
import path from 'node:path';
import zlib from 'node:zlib';
for (const f of process.argv.slice(1)) {
  const raw = fs.readFileSync(f);
  const br = zlib.brotliCompressSync(raw, { params: { [zlib.constants.BROTLI_PARAM_QUALITY]: 11 } });
  console.log(path.basename(f).padEnd(20) + ' ' + String(raw.length).padStart(9) + ' B raw ' + String(br.length).padStart(9) + ' B brotli');
}
" "$dist/pkg/vxr_web_bg.wasm" "$dist/pkg/vxr_web.js" "$dist/scene.vox" "$dist/account.js"
