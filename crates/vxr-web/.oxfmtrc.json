{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": {
    "groups": [
      [
        "value-builtin",
        "value-external"
      ],
      [
        "value-internal",
        "value-parent",
        "value-sibling",
        "value-index"
      ],
      {
        "newlinesBetween": true
      },
      [
        "type-builtin",
        "type-external"
      ],
      [
        "type-internal",
        "type-parent",
        "type-sibling",
        "type-index"
      ],
      "unknown"
    ]
  },
  "ignorePatterns": [
    "**/node_modules/**"
  ]
}
