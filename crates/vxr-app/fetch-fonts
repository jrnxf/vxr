#!/usr/bin/env bash
# Fetch the UI fonts into fonts/ (git-ignored): Geist and Geist Mono 1.3.1 (OFL), the type of
# shadcn/ui's Neutral theme, with Geist Mono UltraBlack for the "vxr" wordmark; Inter 4.1 Regular (OFL) for the symbols Geist lacks (the shortcut
# keys); and the Lucide icon font 1.61.0 (ISC) for the toolbar icons, with their licences (the
# browser build serves them all). Pinned versions, checked by sha256.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
out="$here/fonts"
mkdir -p "$out"
# Fonts an earlier version fetched would otherwise ship with the browser build.
rm -f "$out"/*.ttf "$out"/*.txt
geist=https://unpkg.com/geist@1.3.1
for f in Geist-Regular Geist-Medium Geist-SemiBold; do
  curl -fsSL -o "$out/$f.ttf" "$geist/dist/fonts/geist-sans/$f.ttf"
done
for f in GeistMono-Regular GeistMono-Medium GeistMono-UltraBlack; do
  curl -fsSL -o "$out/$f.ttf" "$geist/dist/fonts/geist-mono/$f.ttf"
done
curl -fsSL -o "$out/Geist-OFL.txt" "$geist/LICENSE.TXT"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
curl -fsSL -o "$tmp/inter.zip" https://github.com/rsms/inter/releases/download/v4.1/Inter-4.1.zip
unzip -o -q -j "$tmp/inter.zip" 'extras/ttf/Inter-Regular.ttf' -d "$out"
unzip -p "$tmp/inter.zip" LICENSE.txt >"$out/Inter-LICENSE.txt"
curl -fsSL -o "$out/lucide.ttf" https://unpkg.com/lucide-static@1.61.0/font/lucide.ttf
curl -fsSL -o "$out/lucide-LICENSE.txt" https://unpkg.com/lucide-static@1.61.0/LICENSE
cd "$out" && shasum -a 256 -c "$here/fonts.sha256"
