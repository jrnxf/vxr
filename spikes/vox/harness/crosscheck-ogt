#!/usr/bin/env bash
# Diff our reader against ogt_vox on every .vox file under the given paths.
# Usage: harness/crosscheck-ogt <file|dir>...   (build target/ogt_dump first)
set -uo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
ogt="$here/../target/ogt_dump"
ours="$here/../target/release/voxtool"
same=0 differ=0 ogt_rejects=0 our_rejects=0
while IFS= read -r f; do
  a="$("$ours" dump "$f" 2>/dev/null)" || { our_rejects=$((our_rejects + 1)); continue; }
  b="$("$ogt" "$f" 2>/dev/null)"
  if [[ "$b" == "rejected" || -z "$b" ]]; then ogt_rejects=$((ogt_rejects + 1)); echo "ogt rejects: $f"; continue; fi
  if [[ "$a" == "$b" ]]; then same=$((same + 1)); else
    differ=$((differ + 1))
    echo "DIFF: $f"
    diff <(echo "$a") <(echo "$b") | head -${CROSSCHECK_LINES:-6} | sed 's/^/    /'
  fi
done < <(find "$@" -iname '*.vox' | sort)
echo "same $same, differ $differ, ogt rejects $ogt_rejects, we reject $our_rejects"
