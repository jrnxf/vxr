#!/usr/bin/env bash
# Run a command inside the spikes dev shell: ./dev cargo build -p vxr-engine
# ./dev --fuzz cargo fuzz run ... uses the nightly shell.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
shell="default"
if [[ "${1:-}" == "--fuzz" ]]; then shell="fuzz"; shift; fi
exec nix develop "path:$here/nix#$shell" -c "$@"
