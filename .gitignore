# Build output: run `node prototype/src/build.mjs` to regenerate.
prototype/demo/
# Scratch space for downloaded references and local evidence; never committed.
.scratch/
# Cargo build output.
/target/
# UI fonts, fetched by crates/vxr-app/fetch-fonts.
/crates/vxr-app/fonts/
# Evidence screenshots from the app.
/crates/vxr-app/shots/
# The browser build, made by crates/vxr-web/build, and its check screenshots.
/crates/vxr-web/dist/
/crates/vxr-web/.wrangler/
# The Worker's npm packages (package-lock.json) and its local secrets for `wrangler dev`.
/crates/vxr-web/node_modules/
/crates/vxr-web/.dev.vars
/crates/vxr-web/shots/
